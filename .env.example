# Every setting the service reads, with its default. Copy to .env for local
# use; .env is in .gitignore and must never be committed. Nothing in this
# file is a secret: ADMIN_TOKEN is deliberately empty.

# --- identity (stamped by the image build, lab sheet 3) --------------------
BUILD_SHA=dev
BUILD_TIME=unknown
ENVIRONMENT=local
SERVICE_NAME=ctf-scoreboard

# --- storage ----------------------------------------------------------------
# SQLite by default. In the cluster (lab sheet 4): sqlite:////data/scoreboard.db
# Postgres also works once psycopg is installed:
#   postgresql+psycopg://scoreboard:<password>@<host>:5432/scoreboard
DATABASE_URL=sqlite:///./data/scoreboard.db

# --- the competition --------------------------------------------------------
CHALLENGES_FILE=data/challenges.yaml
# decay | static   (static is the canary in lab sheet 5, Part D)
SCORING_MODE=decay

# --- administration ---------------------------------------------------------
# Unset or empty: the admin endpoints answer 503 to everybody (fail closed).
ADMIN_TOKEN=

# --- outbound (optional) ----------------------------------------------------
WEBHOOK_URL=
WEBHOOK_TIMEOUT_S=2.0

# --- deliberate faults on GET /scoreboard (lab sheet 5) --------------------
ERROR_RATE=0.0
SLOW_SCOREBOARD_MS=0

# --- server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
